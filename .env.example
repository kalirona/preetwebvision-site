# .env.example
ADMIN_PASSWORD=admin123
JWT_SECRET=super-secret-key-change-this-in-production
GEMINI_API_KEY=

# PostgreSQL Database settings (Coolify / PostgreSQL)
# Support either a single unified connection string:
DATABASE_URL=
# Or individual fields:
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432
DB_SSL=false

# MySQL Database settings
DB_TYPE=mysql
MYSQL_URL=
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
MYSQL_SSL=false

